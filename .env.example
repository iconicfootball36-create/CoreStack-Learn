# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string for Prisma / Cloud SQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/corestack_learn?schema=public"

# JWT_SECRET: Secret used for signing authentication session tokens
JWT_SECRET="corestack-learn-mvp-secret-key-change-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Default application port
PORT=3000

